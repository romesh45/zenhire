# ── Backend ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# When running via docker-compose.prod.yml (services communicate by service name)
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@postgres:5432/zenhire
REDIS_URL=redis://redis:6379

ENVIRONMENT=production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ── Frontend ────────────────────────────────────────────────────────────────
# Public URL of the deployed backend API
NEXT_PUBLIC_API_URL=https://your-api.railway.app

# Generate with: openssl rand -hex 16
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-frontend.railway.app
