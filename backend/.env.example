# ── LLM Providers (set at least ONE) ──────────────────────────────────────────
# The Router tries all configured providers with automatic fallback.

OPENAI_API_KEY=sk-proj-...
# Get from: https://platform.openai.com/api-keys

ANTHROPIC_API_KEY=sk-ant-...
# Get from: https://console.anthropic.com/

GROQ_API_KEY=gsk_...
# Get from: https://console.groq.com/ (FREE tier available)

OPENROUTER_API_KEY=sk-or-...
# Get from: https://openrouter.ai/keys (access 100+ models)

# ── NOTE ON EMBEDDINGS ─────────────────────────────────────────────────────────
# text-embedding-3-small ALWAYS uses OpenAI.
# Groq and OpenRouter do not support embeddings.
# If you only have Groq/OpenRouter, set OPENAI_API_KEY too
# (embeddings are very cheap — ~$0.0001 per resume).

# ── Other required vars ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zenhire
REDIS_URL=redis://localhost:6379
ENVIRONMENT=development
